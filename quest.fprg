<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="zurag1"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-28 07:16:09 PM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLTZSOFBWSzU7MjAyNi0xMC0yODswNjowNzo1NSBQTTsyNzcy"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLTZSOFBWSzU7MjAyNi0xMC0yODswNzoxNjowOSBQTTsxOzI4ODA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, hIn, mIn, mOut, inTotalM, outTotalM, parkedminutes, fee, extraMinutes, maxMinutes, maxCarNo, hOut" type="Integer" array="False" size=""/>
            <output expression="&quot;&#1052;&#1072;&#1096;&#1080;&#1085;&#1099; &#1090;&#1086;&#1086;&#1075; &#1086;&#1088;&#1091;&#1091;&#1083;&#1085;&#1072; &#1091;&#1091;:&quot;" newline="True"/>
            <input variable="n"/>
            <while expression="n &lt; 5">
                <output expression="&quot;&#1256;&#1076;&#1257;&#1088;&#1090; &#1199;&#1081;&#1083;&#1095;&#1080;&#1083;&#1089;&#1101;&#1085; &#1084;&#1072;&#1096;&#1080;&#1085;&#1099; &#1090;&#1086;&#1086;&#1075; &#1086;&#1088;&#1091;&#1091;&#1083;&#1085;&#1072; &#1091;&#1091; (&#1076;&#1086;&#1088; &#1093;&#1072;&#1103;&#1078; 5)&quot;" newline="True"/>
                <input variable="n"/>
            </while>
            <output expression="&quot;&#1052;&#1040;&#1064;&#1048;&#1053;&#1059;&#1059;&#1044;&#1067;&#1053; &#1047;&#1054;&#1043;&#1057;&#1054;&#1054;&#1051;&#1067;&#1053; &#1058;&#1256;&#1051;&#1041;&#1256;&#1056;&#1048;&#1049;&#1053; &#1061;&#1198;&#1057;&#1053;&#1069;&#1043;&#1058;&quot;" newline="True"/>
            <output expression="&quot;&#8470;    &#1054;&#1088;&#1089;&#1086;&#1085; &#1094;&#1072;&#1075;    &#1043;&#1072;&#1088;&#1089;&#1072;&#1085; &#1094;&#1072;&#1075;    &#1047;&#1086;&#1075;&#1089;&#1089;&#1086;&#1085; (&#1084;&#1080;&#1085;)    &#1058;&#1257;&#1083;&#1073;&#1257;&#1088; (&#8366;)&quot;" newline="True"/>
            <assign variable="maxMinutes" expression="-1"/>
            <assign variable="maxCarNo" expression="0"/>
            <assign variable="i" expression="1"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <input variable="hIn"/>
                <input variable="mIn"/>
                <input variable="hOut"/>
                <input variable="mOut"/>
            </for>
            <while expression="hIn &lt; 0 or hIn &gt; 23 or mIn &lt; 0 or mIn &gt; 59 or hOut &lt; 0 or hOut &gt; 23 or mOut &lt; 0 or mOut &gt; 59">
                <output expression="&quot;&#1041;&#1091;&#1088;&#1091;&#1091; &#1094;&#1072;&#1075; &#1101;&#1089;&#1074;&#1101;&#1083; &#1084;&#1080;&#1085;&#1091;&#1090; &#1073;&#1072;&#1081;&#1085;&#1072;. &#1044;&#1072;&#1093;&#1080;&#1085; &#1086;&#1088;&#1091;&#1091;&#1083;&#1085;&#1072; &#1091;&#1091;.&quot;" newline="True"/>
                <input variable="hIn"/>
                <input variable="mIn"/>
                <input variable="hOut"/>
                <input variable="mOut"/>
            </while>
            <assign variable="inTotalM" expression="hIn * 60 + mIn"/>
            <assign variable="outTotalM" expression="hOut * 60 + mOut"/>
            <if expression="outTotalM &gt;= inTotalM">
                <then>
                    <assign variable="parkedMinutes" expression="outTotalM - inTotalM"/>
                </then>
                <else>
                    <assign variable="parkedMinutes" expression="1440 - inTotalM + outTotalM"/>
                </else>
            </if>
            <if expression="parkedMinutes &lt;=30">
                <then>
                    <assign variable="fee" expression="0"/>
                </then>
                <else>
                    <assign variable="extraMinutes" expression="parkedMinutes - 30"/>
                    <assign variable="fee" expression="((extraMinutes +29)/ 30) * 1000"/>
                </else>
            </if>
            <output expression="&quot;&#1052;&#1072;&#1096;&#1080;&#1085;&#1099; &#1090;&#1086;&#1086;:&quot;" newline="True"/>
            <output expression="n" newline="True"/>
            <output expression="&quot;&#1054;&#1088;&#1089;&#1086;&#1085; &#1094;&#1072;&#1075;: &quot;" newline="True"/>
            <output expression="hIn" newline="True"/>
            <output expression="&quot;.&quot;" newline="True"/>
            <output expression="mIn" newline="True"/>
            <output expression="&quot;&#1043;&#1072;&#1088;&#1089;&#1072;&#1085; &#1094;&#1072;&#1075;: &quot;" newline="True"/>
            <output expression="hOut" newline="True"/>
            <output expression="&quot;.&quot;" newline="True"/>
            <output expression="mOut" newline="True"/>
            <output expression="&quot;&#1047;&#1086;&#1075;&#1089;&#1089;&#1086;&#1085; &#1084;&#1080;&#1085;&#1091;&#1090;: &quot;" newline="True"/>
            <output expression="parkedMinutes" newline="True"/>
            <output expression="&quot;&#1058;&#1257;&#1083;&#1073;&#1257;&#1088;: &quot;" newline="True"/>
            <output expression="fee" newline="True"/>
            <if expression="parkedMinutes &gt; maxMinutes">
                <then>
                    <assign variable="maxMinutes" expression="parkedMinutes"/>
                    <assign variable="maxCarNo" expression="i"/>
                </then>
                <else>
                    <assign variable="i" expression="i + 1"/>
                </else>
            </if>
            <output expression="&quot;&#1061;&#1072;&#1084;&#1075;&#1080;&#1081;&#1085; &#1091;&#1076;&#1072;&#1072;&#1085; &#1079;&#1086;&#1075;&#1089;&#1089;&#1086;&#1085; &#1084;&#1072;&#1096;&#1080;&#1085;:&quot;" newline="True"/>
            <output expression="maxCarNo" newline="True"/>
            <output expression="&quot;&#1047;&#1086;&#1075;&#1089;&#1089;&#1086;&#1085; &#1084;&#1080;&#1085;&#1091;&#1090;:&quot;" newline="True"/>
            <output expression="maxMinutes" newline="True"/>
        </body>
    </function>
</flowgorithm>
